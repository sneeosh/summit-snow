{
  "name": "ss-scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "playtest:balance": "SUMMIT_BALANCE_REPORT=1 vitest run --config scripts/balance.config.ts",
    "playtest:expansion": "SUMMIT_EXPANSION_REPORT=1 vitest run --config scripts/expansion.config.ts",
    "playtest:snow": "vitest run --config scripts/snow-recovery.config.ts",
    "check:worker": "tsc -p tsconfig.worker.json",
    "analytics:report": "wrangler d1 execute summit-snow-analytics --remote --command \"SELECT * FROM traffic_sources_30d ORDER BY visits DESC; SELECT * FROM daily_usage ORDER BY date DESC LIMIT 30; SELECT * FROM returning_players_30d;\"",
    "test:admin": "vitest run --config vitest.admin.config.ts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.0"
  }
}
